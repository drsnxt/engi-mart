# Pooled connection used by the app (Neon host includes "-pooler")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/engimart

# Direct connection used by drizzle-kit migrations (no "-pooler")
# For local Postgres this can be the same URL.
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/engimart

# "mock" uses the deterministic local provider; no API key needed
AI_PROVIDER=mock

NEXT_PUBLIC_APP_URL=http://localhost:3000
